# Only the release source roots belong in this repository.
/*
!/.gitignore
!/README.md
!/THIRD_PARTY_NOTICES.md
!/requirements.txt
!/ape_plan_d_supervised_record_copy.py
!/ixi__eapr/
!/abdomen_eapr/
!/tools/
!/protocols/

__pycache__/
*.py[cod]
*.pkl
*.pt
*.pth
*.ckpt
*.nii
*.nii.gz
*.npz
*.npy
*.zip
*.log
*.out
*.png
*.jpg
*.pdf
ixi__eapr/data/
ixi__eapr/model/
abdomen_eapr/*audit*.json
abdomen_eapr/audit_reproduction.py

# Match the source packager's public entry points.
/ixi__eapr/*
!/ixi__eapr/__init__.py
!/ixi__eapr/README.md
!/ixi__eapr/UPSTREAM_README.md
!/ixi__eapr/train.py
!/ixi__eapr/eval_pkl.py
!/ixi__eapr/evaluation_metrics.py
!/ixi__eapr/test_evaluation_metrics.py
!/ixi__eapr/checkpoints.py
!/ixi__eapr/sam2_runtime.py
!/ixi__eapr/voxelmorph/
/ixi__eapr/voxelmorph/torch/external/SynthSeg/
/ixi__eapr/voxelmorph/torch/external/pytools-lib/
